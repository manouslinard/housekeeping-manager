# Copy to .env (cp .env.example .env) and run: uvicorn app.main:app --env-file .env --port 8100
TELEGRAM_BOT_TOKEN=            # from @BotFather. With only this set, the app long-polls (no public URL needed)
TELEGRAM_BOT_USERNAME=         # optional, e.g. Kerkyra_bot (looked up automatically)
TELEGRAM_WEBHOOK_SECRET=       # set (plus PUBLIC_BASE_URL) to use POST /webhooks/telegram instead of polling
PUBLIC_BASE_URL=
GEMINI_API_KEY=                # Google AI Studio key; empty = app works without Gemini
GEMINI_MODEL=gemini-flash-latest
LLM_ENABLED=1
SCHEDULE_XLSX=data/cleaner_schedules.xlsx   # per-cleaner programme, rewritten from the DB, read by Gemini
ADMIN_TOKEN=                   # required once real messaging is on; the web page asks for it

# --- Email (sends cleaners their one-tap Telegram link). Gmail: use an App Password, not your normal password:
#     Google Account > Security > 2-Step Verification (turn on) > App passwords > create one > paste the 16 letters below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                     # the Gmail address that sends, e.g. yourname@gmail.com
SMTP_PASSWORD=                 # the 16-letter App Password
MAIL_FROM=                     # optional, e.g. Housekeeping <yourname@gmail.com>
