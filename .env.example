# Copy to .env and run:  uvicorn app.main:app --env-file .env --port 8000

# --- Messaging (leave both empty to run in dry-run mode: texts are printed, not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=              # your Twilio number, e.g. +15551234567
VIBER_AUTH_TOKEN=         # token of your Viber bot / public account
VIBER_SENDER_NAME=Cleaning
# DRY_RUN=1               # force dry-run even when credentials are set

# --- Where Twilio/Viber can reach this server (needed to verify webhook signatures)
PUBLIC_BASE_URL=https://your-server.example.com
ADMIN_TOKEN=change-me     # send as X-Admin-Token header to /jobs, /admin/sync, ...

# --- Owner alerts (unfilled job, cancellation, job done)
OWNER_PHONE=              # e.g. +306900000000
OWNER_CHANNEL=sms
OWNER_LANGUAGE=en         # en | el

# --- Behaviour
TIMEZONE=Europe/Athens
DEFAULT_COUNTRY_CODE=+30
SYNC_INTERVAL_MIN=15
OFFER_TIMEOUT_MIN=30      # minutes a cleaner has to answer before the next one is asked
OFFER_LEAD_DAYS=14        # start asking this many days before checkout
QUIET_START_HOUR=21       # no texts between 21:00 and 08:00 local time
QUIET_END_HOUR=8
REMINDER_HOUR=18          # day-before reminder
MAX_DISTANCE_KM=0         # 0 = no limit
DEFAULT_MAX_JOBS_PER_DAY=3
STAY_CLEAN_EVERY_DAYS=3   # extra cleaning every N nights during a stay (0 = checkout only)
STAY_CLEAN_TIME=13:00
CLEANING_MIN=60           # one cleaner can't start two jobs closer than this
LOAD_PENALTY_KM=3        # each job a cleaner already holds costs like this many extra km
DEFAULT_CHECKOUT_TIME=11:00
